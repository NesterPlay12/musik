}\cell\pard\intbl\itap1{\fs50\b \uc0\u1053 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1048 \uc0\u1083 \uc0\u1100 \uc0\u1103  \uc0\u1071 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1083 \uc0\u1072 \uc0\u1074 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1095 }\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1052 \uc0\u1091 \uc0\u1078 \uc0\u1095 \uc0\u1080 \uc0\u1085 \uc0\u1072 , 21\uc0\u160 \uc0\u1075 \uc0\u1086 \uc0\u1076 , \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1083 \uc0\u1089 \uc0\u1103  12 \uc0\u1092 \uc0\u1077 \uc0\u1074 \uc0\u1088 \uc0\u1072 \uc0\u1083 \uc0\u1103  2004}\par\pard\intbl\sl260{\fs18 \par +7\uc0\u160 (950)\uc0\u160 9136674 {\cf1\emdash  \uc0\u1087 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1086 \uc0\u1095 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1099 \uc0\u1081  \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1089 \uc0\u1086 \uc0\u1073  \uc0\u1089 \uc0\u1074 \uc0\u1103 \uc0\u1079 \uc0\u1080 }\par {{\field{\*\fldinst HYPERLINK "mailto:nesterov.ilya.9509136674@gmail.com"}{\fldrslt\ul nesterov.ilya.9509136674@gmail.com}}}\par telegram: @nester_play}\par\pard\intbl\sl260{\fs18 \par \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1078 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1077 \uc0\u1090 : \uc0\u1055 \uc0\u1086 \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082  (\uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1100 )\par \uc0\u1043 \uc0\u1088 \uc0\u1072 \uc0\u1078 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 , \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1091 : \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103 \par \uc0\u1043 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1077 \uc0\u1079 \uc0\u1076 \uc0\u1091 : \uc0\u1052 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1074 \uc0\u1072 , \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1082  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1103  \uc0\u1076 \uc0\u1086 \uc0\u1083 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1072 }\cell\row\trowd\cellx6861\clvertalt\cellx9638\pard\intbl\itap1\sa100\sl280{\fs24\b Web-\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082  \uc0\u1085 \uc0\u1072  HTML/CSS/JS}\pard\intbl\itap1\sl260{\fs18 \par{\uc0\u1057 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 :  }\par\li300{\uc0\u8212   \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1080 \uc0\u1089 \uc0\u1090 , \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 }\par\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1058 \uc0\u1080 \uc0\u1087  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 : \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 \par \uc0\u1060 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1072 \uc0\u160 \uc0\u1084 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1077  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 , \uc0\u1091 \uc0\u1076 \uc0\u1072 \uc0\u1083 \uc0\u1105 \uc0\u1085 \uc0\u1085 \uc0\u1086 \par \line\uc0\u1046 \uc0\u1077 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1074  \uc0\u1087 \uc0\u1091 \uc0\u1090 \uc0\u1080  \uc0\u1076 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099 : \uc0\u1085 \uc0\u1077  \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1077 \uc0\u1090  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }}\cell \pard\intbl\itap1\qr{\fs32\qc\b 100\uc0\u160 000\fs18\sl260  \uc0\u8381  \uc0\u1085 \uc0\u1072 \uc0\u160 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1080 }\par\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \emdash 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 }\cell\row\trowd\cellx1400\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1052 \uc0\u1072 \uc0\u1088 \uc0\u1090  2023 \emdash  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1097 \uc0\u1077 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103 \line 3 \uc0\u1075 \uc0\u1086 \uc0\u1076 \uc0\u1072 }\cell\pard\intbl\itap1\par\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1050 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1077  & \uc0\u1041 \uc0\u1077 \uc0\u1083 \uc0\u1086 \uc0\u1077 , \uc0\u1088 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100 }\par\pard\intbl\itap1\sl260{\fs18\cf1 \uc0\u1063 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1073 \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1082 , www.krasnoe-beloe.ru}\par{\fs18 \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1056 \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1089 \uc0\u1077 \uc0\u1090 \uc0\u1100  (\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103 )}}\par {\fs18 \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1099  \uc0\u1087 \uc0\u1080 \uc0\u1090 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103 }\par\li300{{\fs18 \uc0\u8226  \uc0\u1041 \uc0\u1077 \uc0\u1079 \uc0\u1072 \uc0\u1083 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1087 \uc0\u1080 \uc0\u1090 \uc0\u1082 \uc0\u1080  (\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 )}}\par\li300{{\fs18 \uc0\u8226  \uc0\u1040 \uc0\u1083 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1087 \uc0\u1080 \uc0\u1090 \uc0\u1082 \uc0\u1080  (\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1074 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 , \uc0\u1086 \uc0\u1087 \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1083 \uc0\u1103 )}}\par \pard\intbl\itap1\sl280\sb60\sa60{\fs24 \uc0\u1040 \uc0\u1076 \uc0\u1084 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1072 \par}\pard\intbl\itap1\sl260\sa60{\fs18 \uc0\u1052 \uc0\u1086 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1075 , \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1089 \uc0\u1095 \uc0\u1077 \uc0\u1090  \uc0\u1083 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1081 , \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1086 \uc0\u1084 , \uc0\u1089 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072  \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1085 . \uc0\u1058 \uc0\u1088 \uc0\u1091 \uc0\u1076 \uc0\u1086 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1086  \uc0\u1080  \uc0\u1091 \uc0\u1074 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1076 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1074 . \uc0\u1050 \uc0\u1086 \uc0\u1088 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1082 \uc0\u1072  \uc0\u1080  \uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1088 \uc0\u1099 \uc0\u1090 \uc0\u1080 \uc0\u1077  \uc0\u1090 \uc0\u1072 \uc0\u1073 \uc0\u1077 \uc0\u1083 \uc0\u1103  \uc0\u1079 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1090 \uc0\u1099 . {\line}\uc0\u1055 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1082 , \uc0\u1089 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1072  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1074 , \uc0\u1080 \uc0\u1079 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1086 \uc0\u1074  \uc0\u1085 \uc0\u1072  \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1077 , \uc0\u1087 \uc0\u1086 \uc0\u1076 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1095 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1084  \uc0\u1079 \uc0\u1072 \uc0\u1083 \uc0\u1077 , \uc0\u1086 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1088 \uc0\u1086 \uc0\u1074 . \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1072 \uc0\u1078 \uc0\u1077 \uc0\u1081  \uc0\u1087 \uc0\u1086  \uc0\u1083 \uc0\u1080 \uc0\u1085 \uc0\u1080 \uc0\u1080  \uc0\u1057 \uc0\u1041  \uc0\u1086  \uc0\u1085 \uc0\u1077 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1077  \uc0\u1085 \uc0\u1077 \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1077 \uc0\u1090 \uc0\u1085 \uc0\u1080 \uc0\u1084  \uc0\u1072 \uc0\u1083 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1081  \uc0\u1080  \uc0\u1085 \uc0\u1080 \uc0\u1082 \uc0\u1086 \uc0\u1090 \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1088 \uc0\u1078 \uc0\u1072 \uc0\u1097 \uc0\u1077 \uc0\u1081  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1094 \uc0\u1080 \uc0\u1080 .{\line}\uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072  \uc0\u1089  \uc0\u1050 \uc0\u1050 \uc0\u1052  \uc0\u1085 \uc0\u1072  \uc0\u1073 \uc0\u1072 \uc0\u1079 \uc0\u1077  1\uc0\u1057 .{\line}\uc0\u1040  \uc0\u1090 \uc0\u1072 \uc0\u1082 \uc0\u1078 \uc0\u1077 :{\line} - \uc0\u1050 \uc0\u1086 \uc0\u1085 \uc0\u1090 \uc0\u1088 \uc0\u1086 \uc0\u1083 \uc0\u1100  \uc0\u1074 \uc0\u1099 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1083 \uc0\u1072 \uc0\u1085 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1076 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1087 \uc0\u1086 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1081  \uc0\u1101 \uc0\u1092 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 {\line} - \uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1084 \uc0\u1082 \uc0\u1072  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1087 \uc0\u1086  \uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091 , \uc0\u1082 \uc0\u1072 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1091  \uc0\u1080  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 {\line} - \uc0\u1054 \uc0\u1073 \uc0\u1077 \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1093 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1072  \uc0\u1085 \uc0\u1072  \uc0\u1089 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1077 {\line} - \uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1077 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1080 \uc0\u1085 \uc0\u1074 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1088 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 (\uc0\u1088 \uc0\u1077 \uc0\u1074 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1080 ) \uc0\u1090 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1088 \uc0\u1085 \uc0\u1086 -\uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1094 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1081 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1054 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sl220{\fs22\uc0\u1042 \uc0\u1099 \uc0\u1089 \uc0\u1096 \uc0\u1077 \uc0\u1077 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2028\line \uc0\u1042 \uc0\u1099 \uc0\u1089 \uc0\u1096 \uc0\u1077 \uc0\u1077 }\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1053 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1080 \uc0\u1085 \uc0\u1089 \uc0\u1090 \uc0\u1080 \uc0\u1090 \uc0\u1091 \uc0\u1090  \uc0\u1056 \uc0\u1086 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1081 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1093 \uc0\u1080 \uc0\u1084 \uc0\u1080 \uc0\u1082 \uc0\u1086 -\uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1091 \uc0\u1085 \uc0\u1080 \uc0\u1074 \uc0\u1077 \uc0\u1088 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1090 \uc0\u1072   \uc0\u1080 \uc0\u1084 . \uc0\u1044 .\uc0\u1048 . \uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1077 \uc0\u1074 \uc0\u1072 , \uc0\u1053 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1084 \uc0\u1086 \uc0\u1089 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1089 \uc0\u1082  (\uc0\u1058 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1089 \uc0\u1082 \uc0\u1072 \uc0\u1103  \uc0\u1086 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1100 )}\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1050 \uc0\u1080 \uc0\u1073 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072 , \uc0\u1040 \uc0\u1074 \uc0\u1090 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1090 \uc0\u1080 \uc0\u1079 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1099  \uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080  \uc0\u1080  \uc0\u1091 \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 2023\line \uc0\u1057 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1085 \uc0\u1077 \uc0\u1077  \uc0\u1089 \uc0\u1087 \uc0\u1077 \uc0\u1094 \uc0\u1080 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077 }\cell\pard\intbl\itap1\sb250\sl280{\fs24\b \uc0\u1043 \uc0\u1055 \uc0\u1054 \uc0\u1059  \uc0\u1058 \uc0\u1054  "\uc0\u1053 \uc0\u1058 \uc0\u1055 \uc0\u1041 "}\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1050 \uc0\u1086 \uc0\u1084 \uc0\u1084 \uc0\u1077 \uc0\u1088 \uc0\u1094 \uc0\u1080 \uc0\u1103  (\uc0\u1087 \uc0\u1086  \uc0\u1086 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1083 \uc0\u1103 \uc0\u1084 ), \uc0\u1052 \uc0\u1077 \uc0\u1085 \uc0\u1077 \uc0\u1076 \uc0\u1078 \uc0\u1077 \uc0\u1088  \uc0\u1087 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1072 \uc0\u1084 }\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1055 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1082 \uc0\u1074 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1092 \uc0\u1080 \uc0\u1082 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1099 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 2026}\cell\pard\intbl\itap1\sl280{\fs24\b \uc0\u1057 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  web-\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1083 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081  \uc0\u1089  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  Python}\par\pard\intbl\itap1\sl260{\fs18 \uc0\u1040 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1103  \uc0\u1058 \uc0\u1054 \uc0\u1055 , HTML/CSS}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077  \uc0\u1103 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1086 \uc0\u1074 }\cell\pard\intbl\itap1\sl260{\fs18 \uc0\u1056 \uc0\u1091 \uc0\u1089 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  {\cf1\emdash  \uc0\u1056 \uc0\u1086 \uc0\u1076 \uc0\u1085 \uc0\u1086 \uc0\u1081 }}\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sb250\sl220{\fs16\cf3 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }\cell\pard\intbl\itap1\sb250\sl260{\fs18 {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1073 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1080 \~\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1073 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1096 \uc0\u1080 \uc0\u1084 \~\uc0\u1086 \uc0\u1073 \uc0\u1098 \uc0\u1077 \uc0\u1084 \uc0\u1086 \uc0\u1084 \~\uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1059 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100 \~\uc0\u1074 \~\uc0\u1082 \uc0\u1086 \uc0\u1083 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1073 \uc0\u1072 \uc0\u1079 \uc0\u1072 \uc0\u1084 \uc0\u1080 \~\uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1055 \uc0\u1086 \uc0\u1080 \uc0\u1089 \uc0\u1082 \~\uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 \~\uc0\u1074 \~\uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1085 \uc0\u1077 \uc0\u1090 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1054 \uc0\u1088 \uc0\u1075 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1079 \uc0\u1072 \uc0\u1090 \uc0\u1086 \uc0\u1088 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077 \~\uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 \~\uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 }  {\cb5\chcfpat5\chcbpat5 MS\~PowerPoint}  {\cb5\chcfpat5\chcbpat5 \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \~\uc0\u1089 \~\uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 1\uc0\u1057 :\~\uc0\u1055 \uc0\u1088 \uc0\u1077 \uc0\u1076 \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1103 \uc0\u1090 \uc0\u1080 \uc0\u1077 \~8}  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1053 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080 \~\uc0\u1084 \uc0\u1077 \uc0\u1078 \uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 \~\uc0\u1086 \uc0\u1073 \uc0\u1097 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1103 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1058 \uc0\u1077 \uc0\u1083 \uc0\u1077 \uc0\u1092 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1077 \~\uc0\u1087 \uc0\u1077 \uc0\u1088 \uc0\u1077 \uc0\u1075 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1088 \uc0\u1099 ,\~\uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1077 \uc0\u1084 \~\uc0\u1080 \~\uc0\u1086 \uc0\u1073 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1072 \~\uc0\u1079 \uc0\u1072 \uc0\u1082 \uc0\u1072 \uc0\u1079 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1086 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1076 \uc0\u1086 \uc0\u1082 \uc0\u1091 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1048 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \~\uc0\u1083 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1093 \~\uc0\u1087 \uc0\u1086 \uc0\u1088 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 \~\uc0\u1088 \uc0\u1091 \uc0\u1082 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1076 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1103 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1050 \uc0\u1086 \uc0\u1088 \uc0\u1088 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1091 \uc0\u1088 \uc0\u1072 \~\uc0\u1090 \uc0\u1077 \uc0\u1082 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1074 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1040 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1082 \uc0\u1072 \~\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1072 \uc0\u1078 }  {\cb5\chcfpat5\chcbpat5 \uc0\u1042 \uc0\u1077 \uc0\u1073 -\uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1075 \uc0\u1088 \uc0\u1072 \uc0\u1084 \uc0\u1084 \uc0\u1080 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 }  {\cb5\chcfpat5\chcbpat5 Python}  {\cb5\chcfpat5\chcbpat5 Backend}  {\cb5\chcfpat5\chcbpat5 HTML5}  {\cb5\chcfpat5\chcbpat5 GitHub}  {\cb5\chcfpat5\chcbpat5 HTML}  {\cb5\chcfpat5\chcbpat5 CSS3}}\cell\row\trowd\cellx9638\pard\intbl\itap1\sa150\sb500\brdrb\brdrs\brdrcf2{\fs22\cf1 \uc0\u1044 \uc0\u1086 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1085 \uc0\u1080 \uc0\u1090 \uc0\u1077 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1072 \uc0\u1103  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1103 }\cell\row\trowd\cellx1800\cellx9638\pard\intbl\itap1\sl220{\fs16\cf3 \uc0\u1054 \uc0\u1073 \uc0\u1086  \uc0\u1084 \uc0\u1085 \uc0\u1077 }\cell\pard\intbl\itap1\sl260{\fs18 Frontend-\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082  \uc0\u1089  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1084  \uc0\u1089 \uc0\u1082 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1086 \uc0\u1084  \uc0\u1091 \uc0\u1084 \uc0\u1072  \uc0\u1080  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1089 \uc0\u1086 \uc0\u1079 \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1074 \uc0\u1077 \uc0\u1073 -\uc0\u1088 \uc0\u1077 \uc0\u1096 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1081 : \uc0\u1083 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1080 \uc0\u1085 \uc0\u1075 \uc0\u1086 \uc0\u1074 , \uc0\u1086 \uc0\u1085 \uc0\u1083 \uc0\u1072 \uc0\u1081 \uc0\u1085 -\uc0\u1084 \uc0\u1072 \uc0\u1088 \uc0\u1082 \uc0\u1077 \uc0\u1090 \uc0\u1087 \uc0\u1083 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1080 \uc0\u1075 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1093  \uc0\u1084 \uc0\u1072 \uc0\u1075 \uc0\u1072 \uc0\u1079 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1074 . \uc0\u1056 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1102  \uc0\u1089  HTML/CSS, \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1102  \uc0\u1080 \uc0\u1085 \uc0\u1090 \uc0\u1077 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1099 \uc0\u1077  \uc0\u1101 \uc0\u1083 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1090 \uc0\u1099  \uc0\u1085 \uc0\u1072  JavaScript (\uc0\u1090 \uc0\u1077 \uc0\u1089 \uc0\u1090 \uc0\u1099 , \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1080 , \uc0\u1084 \uc0\u1091 \uc0\u1079 \uc0\u1099 \uc0\u1082 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086 \uc0\u1077  \uc0\u1089 \uc0\u1086 \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1074 \uc0\u1086 \uc0\u1078 \uc0\u1076 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 ). \uc0\u1048 \uc0\u1084 \uc0\u1077 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1082 \uc0\u1080  \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1095 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1089 \uc0\u1072 \uc0\u1081 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077  \uc0\u1089  \uc0\u1080 \uc0\u1089 \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1086 \uc0\u1074 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  Git. \uc0\u1047 \uc0\u1085 \uc0\u1072 \uc0\u1102  \uc0\u1086 \uc0\u1089 \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099  SQL \uc0\u1080  \uc0\u1088 \uc0\u1077 \uc0\u1083 \uc0\u1103 \uc0\u1094 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1073 \uc0\u1072 \uc0\u1079  \uc0\u1076 \uc0\u1072 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1076 \uc0\u1083 \uc0\u1103  \uc0\u1101 \uc0\u1092 \uc0\u1092 \uc0\u1077 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086  \uc0\u1074 \uc0\u1079 \uc0\u1072 \uc0\u1080 \uc0\u1084 \uc0\u1086 \uc0\u1076 \uc0\u1077 \uc0\u1081 \uc0\u1089 \uc0\u1090 \uc0\u1074 \uc0\u1080 \uc0\u1103  \uc0\u1089  \uc0\u1073 \uc0\u1101 \uc0\u1082 \uc0\u1077 \uc0\u1085 \uc0\u1076 \uc0\u1086 \uc0\u1084 .{\line}{\line}\uc0\u1055 \uc0\u1088 \uc0\u1080 \uc0\u1074 \uc0\u1099 \uc0\u1082  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1090 \uc0\u1100  \uc0\u1085 \uc0\u1072  \uc0\u1088 \uc0\u1077 \uc0\u1079 \uc0\u1091 \uc0\u1083 \uc0\u1100 \uc0\u1090 \uc0\u1072 \uc0\u1090  \uc0\u1074  \uc0\u1091 \uc0\u1089 \uc0\u1083 \uc0\u1086 \uc0\u1074 \uc0\u1080 \uc0\u1103 \uc0\u1093  \uc0\u1084 \uc0\u1085 \uc0\u1086 \uc0\u1075 \uc0\u1086 \uc0\u1079 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1095 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1080 , \uc0\u1073 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086  \uc0\u1086 \uc0\u1089 \uc0\u1074 \uc0\u1072 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1099 \uc0\u1077  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1080  (\uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086  \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1095 \uc0\u1072 \uc0\u1102  Python \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1072 \uc0\u1093 ). \uc0\u1054 \uc0\u1073 \uc0\u1083 \uc0\u1072 \uc0\u1076 \uc0\u1072 \uc0\u1102  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 \uc0\u1086 \uc0\u1084  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1099  \uc0\u1089  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1094 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1080  \uc0\u1089 \uc0\u1080 \uc0\u1089 \uc0\u1090 \uc0\u1077 \uc0\u1084 \uc0\u1072 \uc0\u1084 \uc0\u1080 , \uc0\u1095 \uc0\u1090 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1083 \uc0\u1086  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1076 \uc0\u1091 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1074 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1080  \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1086 \uc0\u1091 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1081 \uc0\u1095 \uc0\u1080 \uc0\u1074 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100 .{\line}{\line}\uc0\u1042  \uc0\u1085 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1086 \uc0\u1103 \uc0\u1097 \uc0\u1077 \uc0\u1077  \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1103  \uc0\u1091 \uc0\u1075 \uc0\u1083 \uc0\u1091 \uc0\u1073 \uc0\u1083 \uc0\u1103 \uc0\u1102  \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1085 \uc0\u1080 \uc0\u1103  \uc0\u1085 \uc0\u1072  \uc0\u1082 \uc0\u1091 \uc0\u1088 \uc0\u1089 \uc0\u1072 \uc0\u1093  "Web-\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082  \uc0\u1085 \uc0\u1072  Python" (\uc0\u1040 \uc0\u1082 \uc0\u1072 \uc0\u1076 \uc0\u1077 \uc0\u1084 \uc0\u1080 \uc0\u1103  I-Top) \uc0\u1080  "\uc0\u1055 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1103  Python-\uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1095 \uc0\u1080 \uc0\u1082 " (SkillBox).{\line}{\line}\uc0\u1048 \uc0\u1097 \uc0\u1091  \uc0\u1074 \uc0\u1086 \uc0\u1079 \uc0\u1084 \uc0\u1086 \uc0\u1078 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1072 \uc0\u1079 \uc0\u1074 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1074  IT-\uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 , \uc0\u1075 \uc0\u1076 \uc0\u1077  \uc0\u1089 \uc0\u1084 \uc0\u1086 \uc0\u1075 \uc0\u1091  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1103 \uc0\u1090 \uc0\u1100  \uc0\u1072 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1080 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1077  \uc0\u1085 \uc0\u1072 \uc0\u1074 \uc0\u1099 \uc0\u1082 \uc0\u1080  \uc0\u1080  \uc0\u1087 \uc0\u1088 \uc0\u1080 \uc0\u1085 \uc0\u1086 \uc0\u1089 \uc0\u1080 \uc0\u1090 \uc0\u1100  \uc0\u1088 \uc0\u1077 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1091 \uc0\u1102  \uc0\u1087 \uc0\u1086 \uc0\u1083 \uc0\u1100 \uc0\u1079 \uc0\u1091 , \uc0\u1085 \uc0\u1072 \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1072 \uc0\u1090 \uc0\u1099 \uc0\u1074 \uc0\u1072 \uc0\u1103  \uc0\u1087 \uc0\u1088 \uc0\u1072 \uc0\u1082 \uc0\u1090 \uc0\u1080 \uc0\u1095 \uc0\u1077 \uc0\u1089 \uc0\u1082 \uc0\u1080 \uc0\u1081  \uc0\u1086 \uc0\u1087 \uc0\u1099 \uc0\u1090 . \uc0\u1041 \uc0\u1099 \uc0\u1089 \uc0\u1090 \uc0\u1088 \uc0\u1086  \uc0\u1091 \uc0\u1089 \uc0\u1074 \uc0\u1072 \uc0\u1080 \uc0\u1074 \uc0\u1072 \uc0\u1102  \uc0\u1085 \uc0\u1086 \uc0\u1074 \uc0\u1091 \uc0\u1102  \uc0\u1080 \uc0\u1085 \uc0\u1092 \uc0\u1086 \uc0\u1088 \uc0\u1084 \uc0\u1072 \uc0\u1094 \uc0\u1080 \uc0\u1102 , \uc0\u1091 \uc0\u1074 \uc0\u1083 \uc0\u1077 \uc0\u1082 \uc0\u1072 \uc0\u1102 \uc0\u1089 \uc0\u1100  \uc0\u1080 \uc0\u1079 \uc0\u1091 \uc0\u1095 \uc0\u1077 \uc0\u1085 \uc0\u1080 \uc0\u1077 \uc0\u1084  \uc0\u1089 \uc0\u1086 \uc0\u1074 \uc0\u1088 \uc0\u1077 \uc0\u1084 \uc0\u1077 \uc0\u1085 \uc0\u1085 \uc0\u1099 \uc0\u1093  \uc0\u1090 \uc0\u1077 \uc0\u1093 \uc0\u1085 \uc0\u1086 \uc0\u1083 \uc0\u1086 \uc0\u1075 \uc0\u1080 \uc0\u1081  \uc0\u1080  \uc0\u1075 \uc0\u1086 \uc0\u1090 \uc0\u1086 \uc0\u1074  \uc0\u1087 \uc0\u1088 \uc0\u1086 \uc0\u1092 \uc0\u1077 \uc0\u1089 \uc0\u1089 \uc0\u1080 \uc0\u1086 \uc0\u1085 \uc0\u1072 \uc0\u1083 \uc0\u1100 \uc0\u1085 \uc0\u1086  \uc0\u1088 \uc0\u1072 \uc0\u1089 \uc0\u1090 \uc0\u1080  \uc0\u1074  \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1072 \uc0\u1085 \uc0\u1076 \uc0\u1077 .{\line}{\line}\uc0\u1052 \uc0\u1086 \uc0\u1078 \uc0\u1077 \uc0\u1090 \uc0\u1077  \uc0\u1086 \uc0\u1079 \uc0\u1085 \uc0\u1072 \uc0\u1082 \uc0\u1086 \uc0\u1084 \uc0\u1080 \uc0\u1090 \uc0\u1100 \uc0\u1089 \uc0\u1103  \uc0\u1089  \uc0\u1084 \uc0\u1086 \uc0\u1080 \uc0\u1084 \uc0\u1080  \uc0\u1088 \uc0\u1072 \uc0\u1073 \uc0\u1086 \uc0\u1090 \uc0\u1072 \uc0\u1084 \uc0\u1080  \uc0\u1085 \uc0\u1072  GitHub: https://github.com/NesterPlay12/education}\cell\row\pard}